[Unit]
Description=FT Anomaly Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pc
Group=pc
WorkingDirectory=/home/pc/Projects/ft-anomaly-bot
EnvironmentFile=/home/pc/Projects/ft-anomaly-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pc/Projects/ft-anomaly-bot/venv/bin/python /home/pc/Projects/ft-anomaly-bot/main.py
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
